{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DisCrab",
  "version": "1.1.6",
  "identifier": "com.streamcompanion.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build || npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DisCrab",
        "width": 460,
        "height": 680,
        "minWidth": 420,
        "minHeight": 500,
        "resizable": false,
        "decorations": false,
        "center": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' blob: data: ws: wss: http: https:; media-src 'self' blob: mediastream:; connect-src 'self' ws: wss: https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
